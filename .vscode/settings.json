{
  // Biome formats and lints this project (biome.json). The per-language blocks
  // are needed: a user's own `[typescript]` formatter outranks a plain
  // workspace `editor.defaultFormatter`, so only the same blocks here win.
  "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
  "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[json]": { "editor.defaultFormatter": "biomejs.biome" },
  "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
  "editor.formatOnSave": true,
  // Replaces the user-level list rather than adding to it, which also drops
  // ESLint's fix-all: there is no ESLint here to run.
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "eslint.enable": false
}
